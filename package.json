{
  "name": "tls-expiry-checker",
  "version": "0.1.0",
  "description": "Check TLS certificates on many hosts and warn before they expire. No runtime dependencies.",
  "license": "MIT",
  "author": "Ahmed Morsy",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "tls-expiry": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "prepare": "npm run build"
  },
  "keywords": [
    "tls",
    "ssl",
    "certificate",
    "expiry",
    "monitoring",
    "lets-encrypt"
  ],
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~5.9.0"
  }
}
